{
  "name": "Planalyzer (.NET 8 + SQL Server 2022)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "containerEnv": {
    "MSSQL_SA_PASSWORD": "Planalyzer_Dev_2026!",
    "PLANALYZER_DEMO_CONN": "Server=db,1433;Database=PlanalyzerDemo;User Id=sa;Password=Planalyzer_Dev_2026!;TrustServerCertificate=True;Encrypt=False",
    "PLANALYZER_HISTORY_CONN": "Host=historydb;Port=5432;Database=planalyzer;Username=planalyzer;Password=planalyzer_dev_2026",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "forwardPorts": [5057],
  "portsAttributes": {
    "5057": {
      "label": "Planalyzer Web",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-mssql.mssql"
      ],
      "settings": {
        "dotnet.defaultSolution": "Planalyzer.sln",
        "files.exclude": {
          "**/bin": true,
          "**/obj": true
        }
      }
    }
  }
}
